#!/usr/bin/env sh
# pre-push: corre el precheck del repo antes de pushear (evita romper CI).
# Instalar: git config core.hooksPath .githooks
# Bypass:   git push --no-verify   |   HOOK_SKIP=1 git push
set -u
[ "${HOOK_SKIP:-0}" = "1" ] && { echo "pre-push: skipped (HOOK_SKIP=1)"; exit 0; }
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
command -v go >/dev/null 2>&1 || { echo "pre-push: go ausente, skip"; exit 0; }

if command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-push: make lint"
  make lint || { echo "pre-push: lint fallo"; exit 1; }
else
  echo "pre-push: golangci-lint ausente -> go vet"
  go vet ./... || { echo "pre-push: vet fallo"; exit 1; }
fi
echo "pre-push: go build ./..."
go build ./... || { echo "pre-push: build fallo"; exit 1; }
echo "pre-push: make test"
make test || { echo "pre-push: tests fallaron"; exit 1; }
echo "pre-push: OK"
