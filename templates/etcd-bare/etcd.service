[Unit]
Description=etcd DCS member (etcd-bare, native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=etcd
Group=etcd
ExecStart=/usr/local/bin/etcd --config-file=/opt/sdk-ops/services/etcd-bare/etcd.conf.yml
EnvironmentFile=-/opt/sdk-ops/services/etcd-bare/etcd.env
# Resource limits (docker mem_limit/cpus 1:1): MemoryMax from the profile
# render; CPUQuota from cpus (0.5 -> 0.500%, 1 -> 100%).
MemoryMax={{ .MemLimit }}
CPUQuota={{ .Cpus }}00%
Restart=always
RestartSec=5
LimitNOFILE=65536
# Hardening: etcd only writes the data dir (ProtectSystem=strict + the
# ReadWritePaths exception below).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/etcd

[Install]
WantedBy=multi-user.target
