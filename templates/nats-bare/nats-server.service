[Unit]
Description=NATS Server (nats-bare, native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nats
Group=nats
ExecStart=/usr/local/bin/nats-server -c /opt/sdk-ops/services/nats-bare/nats.conf
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/opt/sdk-ops/services/nats-bare/.env
MemoryMax={{ .MemLimit }}
CPUQuota={{ .Cpus }}00%
Restart=always
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nats

[Install]
WantedBy=multi-user.target
