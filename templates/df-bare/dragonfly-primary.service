# Dragonfly primary (df-bare) - native binary + systemd, no Docker.
# Resource limits (docker mem_limit/cpus 1:1): MemoryMax comes from the
# profile render; CPUQuota is normalized to % by init.sh.
[Unit]
Description=Dragonfly KV primary (df-bare)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dragonfly
Group=dragonfly
ExecStart=/usr/local/bin/dragonfly --flagfile=/etc/dragonfly/primary.conf
WorkingDirectory=/var/lib/dragonfly/primary
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
MemoryMax={{ .DF_MEM }}
CPUQuota=100%

[Install]
WantedBy=multi-user.target
